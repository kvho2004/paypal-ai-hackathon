ANTHROPIC_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_MERCHANT_CLIENT_ID=     # Demo Diner (payee) app; creates/captures orders. See docs/checkout.md
PAYPAL_MERCHANT_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # registered on the Demo Diner app
SEED_RECIPIENT_EMAIL= # sandbox-only: another sandbox account's email, used by scripts/seed-sandbox.ts
KERNEL_API_KEY=
DATABASE_URL=
APP_URL=
DEMO_DINER_URL=  # optional; defaults to https://krumms-web.onrender.com/demo-diner (Kernel can't reach localhost)
DEMO_MODE=true   # seeds demo user, enables Demo Diner
ZAPIER_HOOK_URL= # optional; alerts disabled if empty
